# API 基础地址
# - 真机调试（局域网）：http://<电脑IP>:3000
# - 生产环境（线上 HTTPS）：https://api.example.com
VITE_API_BASE_URL=https://api.example.com

# 仅本地开发者工具使用；正式环境不要设置
VITE_DEVTOOLS_API_BASE_URL=http://127.0.0.1:3000

# ICP 备案号（账户页页脚显示，生产环境必填）
VITE_ICP_RECORD=陕ICP备XXXXXXXX号

# 公安备案号（30 天内补办；可选）
VITE_PUBLIC_SECURITY_RECORD=

# 隐私政策中的运营者联系渠道，正式环境必填
VITE_PRIVACY_CONTACT=请填写运营者手机号或客服微信

# 开发环境可开启模拟手机号注册（真机调试时在手机号授权失败后弹出模拟注册选项）
# VITE_ENABLE_MOCK_PHONE=true

# 本地接口不可用时展示示例商品；正式环境必须关闭
# VITE_ENABLE_CATALOG_FALLBACK=true

# wx.login 失败时使用本地模拟身份；正式环境必须关闭
# VITE_ENABLE_DEV_LOGIN_FALLBACK=true
