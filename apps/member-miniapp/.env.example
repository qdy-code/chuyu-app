# API 基础地址
# - 微信开发者工具模拟器（本地 API）：http://127.0.0.1:3000
# - 真机调试（局域网）：http://<电脑IP>:3000
# - 生产环境（线上 HTTPS）：https://chuy.shop/api
VITE_API_BASE_URL=https://chuy.shop/api

# ICP 备案号（账户页页脚显示，生产环境必填）
VITE_ICP_RECORD=陕ICP备XXXXXXXX号

# 公安备案号（30 天内补办；可选）
VITE_PUBLIC_SECURITY_RECORD=

# 开发环境可开启模拟手机号注册（真机调试时在手机号授权失败后弹出模拟注册选项）
# VITE_ENABLE_MOCK_PHONE=true
