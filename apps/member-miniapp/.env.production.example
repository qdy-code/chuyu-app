# 正式 API 必须是已加入微信 request/downloadFile/uploadFile 合法域名的公网 HTTPS 地址
VITE_API_BASE_URL=https://www.moonisle.shop/api
VITE_DEVTOOLS_API_BASE_URL=

# 运营者真实联系方式，会显示在隐私政策中
VITE_PRIVACY_CONTACT=13800000000

# 有真实备案号时填写；没有时留空，禁止填写占位内容
VITE_ICP_RECORD=
VITE_PUBLIC_SECURITY_RECORD=

VITE_ENABLE_MOCK_PHONE=false
VITE_ENABLE_DEV_LOGIN_FALLBACK=false
VITE_ENABLE_CATALOG_FALLBACK=false

# 对顾客公开的门店资料。仅填写门店确认的内容；经纬度使用 GCJ-02。
# 无经纬度时显示“复制地址”；未填写电话时不显示拨号入口。
VITE_STORE_PHONE=
VITE_STORE_ADDRESS=
VITE_STORE_HOURS=
VITE_STORE_LATITUDE=
VITE_STORE_LONGITUDE=
