    "naive-ui": "^2.44.1",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vue-tsc": "^3.0.6"
  }
}
