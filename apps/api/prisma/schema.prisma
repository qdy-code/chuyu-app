generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id           String  @id
  openId       String  @unique
  phone        String? @unique
  phoneVerifiedAt DateTime?
  nickname     String
  remark       String?
  avatarUrl    String
  birthday     String?
  levelId      String
  levelName    String
  discountRate Float
  balance      Float
  points       Float
  accountIdChangedAt DateTime?
  deletedAt    DateTime?
  pospalLink   PospalMemberLink?
  pospalSync   PospalMemberSync?

  @@index([levelId])
}

model MemberLevel {
  id           String @id
  name         String
  minPoints    Int
  discountRate Float
}

model PospalMemberLink {
  memberId       String   @id
  customerUid    String   @unique
  customerNumber String
  account        String
  createdAt      DateTime @default(now())
  lastSyncedAt   DateTime?
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model PospalMemberSync {
  memberId String @id
  account String
  customerNumber String @unique
  customerUid String?
  state String @default("PENDING")
  revision Int @default(1)
  attempts Int @default(0)
  createAttemptedAt DateTime?
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  lastError String?
  updatedAt DateTime @updatedAt
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([state, nextAttemptAt])
}

model RechargeOrder {
  id           String   @id
  userId       String
  amount       Float
  status       String
  rejectReason String?
  createdAt    DateTime
  updatedAt    DateTime

  @@index([userId])
  @@index([status])
}

model ConsumptionOrder {
  id            String   @id
  orderNo       String   @unique
  userId        String
  productType   String?
  title         String
  originalPrice Float
  finalPrice    Float
  discountRate  Float
  effectImages  String[]  @default([])
  orderDate     String
  remark        String?
  createdBy     String
  createdAt     DateTime
  voidedAt      DateTime?
  voidedBy      String?

  @@index([userId])
  @@index([orderNo])
}

model MemberLinkRequest {
  userId         String   @id
  targetMemberId String
  codeHash       String   @unique
  expiresAt      DateTime
  consumedAt     DateTime?

  @@index([targetMemberId])
}

model MutationReceipt {
  id          String   @id
  payloadHash String
  result      Json
  createdAt   DateTime @default(now())
}

model MemberMessage {
  id        String   @id
  userId    String
  content   String
  createdAt DateTime @default(now())
  readAt    DateTime?
  reply     String?
  repliedAt DateTime?
  repliedBy String?

  @@index([userId, createdAt])
  @@index([readAt, createdAt])
}

model ProductType {
  id        String   @id
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime

  @@index([sortOrder])
}

model NailCategory {
  id        String   @id
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime

  @@index([sortOrder])
}

model AccessoryCategory {
  id        String   @id
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime

  @@index([sortOrder])
}

model FlowerCategory {
  id        String   @id
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime

  @@index([sortOrder])
}

model NailProduct {
  id             String   @id
  categoryId     String?
  categoryName   String?
  name           String
  description    String?
  referencePrice Float?
  images         String[] @default([])
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime
  updatedAt      DateTime

  @@index([categoryId])
  @@index([sortOrder])
  @@index([isActive])
}

model AccessoryProduct {
  id                    String   @id
  categoryId            String?
  categoryName          String?
  name                  String
  description           String?
  referencePrice        Float?
  images                String[] @default([])
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  reservedByUserId      String?
  reservedAppointmentId String?
  reservedAt            DateTime?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([categoryId])
  @@index([sortOrder])
  @@index([isActive])
  @@index([reservedByUserId])
}

model FlowerProduct {
  id             String   @id
  categoryId     String?
  categoryName   String?
  name           String
  description    String?
  referencePrice Float?
  images         String[] @default([])
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime
  updatedAt      DateTime

  @@index([categoryId])
  @@index([sortOrder])
  @@index([isActive])
}

model Appointment {
  id              String   @id
  userId          String
  memberNickname  String
  businessType    String   @default("NAIL")
  productId       String?
  productName     String?
  appointmentDate String
  startTime       String
  endTime         String
  status          String
  remark          String?
  adminRemark     String?
  createdAt       DateTime
  updatedAt       DateTime

  @@index([userId])
  @@index([businessType])
  @@index([productId])
  @@index([appointmentDate])
  @@index([status])
}

model AppointmentUnavailableDate {
  id              String   @id
  appointmentDate String
  businessType    String
  reason          String?
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([appointmentDate, businessType])
  @@index([appointmentDate])
  @@index([businessType])
}

model BalanceLedger {
  id             String   @id
  userId         String
  changeAmount   Float
  type           String
  relatedOrderId String?
  createdAt      DateTime

  @@index([userId])
}

model PointsLedger {
  id             String   @id
  userId         String
  changePoints   Float
  beforePoints   Float
  afterPoints    Float
  reason         String
  relatedOrderId String?
  sourceAuditId  String?  @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime

  @@index([targetType, targetId])
  @@index([createdAt])
}

model AdminUser {
  id   String @id
  name String
  role String
}
