API_PORT=3000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:password@localhost:5432/member_platform?schema=public

# 认证密钥，生产环境至少 32 位随机字符串
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# 管理后台登录密码
ADMIN_PASSWORD=your-admin-password

# 正式环境上传目录必须位于持久化磁盘
# UPLOAD_DIR=/data/moonisle/uploads

# CORS 允许的后台网页来源（逗号分隔）；生产环境必填且仅允许 HTTPS
# 示例: CORS_ORIGIN=https://admin.example.com,https://www.example.com
# CORS_ORIGIN=

# 微信小程序登录模式
# mock = 本地开发用模拟数据，不调用真实微信 API
# real = 生产环境，调用真实微信 API
MINIAPP_LOGIN_MODE=mock
MINIAPP_MOCK_OPEN_ID=mock-openid-local-user
MINIAPP_MOCK_PHONE=13800138000

# 上线时改为 real 模式，并填写微信小程序后台的 AppID/AppSecret
# MINIAPP_LOGIN_MODE=real
# WECHAT_MINIAPP_APP_ID=
# WECHAT_MINIAPP_APP_SECRET=

# 正式启动时同时设置 NODE_ENV=production，服务会拒绝不安全配置

# 本地开发可自动补充示例产品；生产环境不会自动创建示例产品
# SEED_DEMO_CATALOG=true

# E2E 会重置数据库，必须使用名称中包含 test 或 e2e 的独立数据库
# E2E_DATABASE_URL=postgresql://postgres:password@localhost:5432/member_platform_e2e?schema=public
