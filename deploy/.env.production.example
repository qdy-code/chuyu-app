# Copy this file to .env.production and fill in real values.
# .env.production is gitignored — never commit secrets.

# Database password (any strong password)
DB_PASSWORD=change_me_strong_db_password

# JWT signing secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change_me_random_64_chars

# Admin login password
ADMIN_PASSWORD=change_me_admin_password

# CORS allowed origins (comma-separated HTTPS origins only).
CORS_ORIGIN=https://moonisle.shop

# Public domain served by Caddy. DNS must point to this server.
APP_DOMAIN=moonisle.shop

# WeChat MiniProgram credentials (from mp.weixin.qq.com)
WECHAT_MINIAPP_APP_ID=wx1cf2caed662f562a
WECHAT_MINIAPP_APP_SECRET=your_wx_app_secret

# Backups live outside the Git checkout so code updates cannot overwrite them.
BACKUP_DIR=/var/backups/moonisle
BACKUP_RETENTION_DAYS=30

# 银豹接口凭证仅配置在服务端。此阶段仅开放只读核对。
POSPAL_ENABLED=false
# 启用后台开户及昵称同步；余额/积分写入仍禁用
POSPAL_MEMBER_SYNC_ENABLED=false
POSPAL_ACCOUNT_SOURCE=local
POSPAL_APP_ID=
POSPAL_APP_KEY=
POSPAL_ACCOUNT=
